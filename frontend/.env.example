# ── Database ──────────────────────────────────────────────────────────────────
# Local: MySQL en tu PC. En Vercel: la URL de tu MySQL en la nube (ver DEPLOY.md), p. ej.
#   mysql://usuario:clave@host:4000/peleanalise?sslaccept=strict&connection_limit=1
DATABASE_URL="mysql://root:password@localhost:3306/peleanalise"

# ── JWT (usa valores largos y aleatorios en producción) ───────────────────────
JWT_SECRET="change-me-super-secret-jwt-key-256bits"
JWT_REFRESH_SECRET="change-me-super-secret-refresh-key-256bits"

# ── Servicio de IA ────────────────────────────────────────────────────────────
PYTHON_AI_URL="http://localhost:8000"
# Clave compartida con el servicio de IA (misma AI_API_KEY allá). Vacía en local.
AI_API_KEY=""

# ── Imágenes (solo en Vercel): token de Vercel Blob. Vacío = se guardan en frontend/uploads/ ──
BLOB_READ_WRITE_TOKEN=""

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV="development"
